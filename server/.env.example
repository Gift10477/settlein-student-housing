DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=settlein_db
DB_PORT=3306
PORT=5000

API_KEYS=your_dev_key_here,your_ring_partner_key_here

# Partner integration settings
SHAMBA_API_URL=
# Required by the current Shamba contract: use the read-only ring-partner key.
SHAMBA_API_KEY=
# Current contract uses X-API-Key without a prefix.
SHAMBA_API_KEY_HEADER=X-API-Key
SHAMBA_API_KEY_PREFIX=
# Optional key from API_KEYS for the local Vite proxy; falls back to its first key.
SETTLEIN_WEB_API_KEY=
# Optional preferred IDs; live tests discover current records if absent or unavailable.
SHAMBA_LISTING_ID=
SHAMBA_FARMER_ID=
SHAMBA_HEADQUARTERS_ID=

# The supplied Shamba 1.0.0 contract uses /api/market-prices and a bare array.
PARTNER_VERSION=v1
