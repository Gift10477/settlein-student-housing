DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=settlein_db
DB_PORT=3306
PORT=5000

API_KEYS=your_dev_key_here,your_ring_partner_key_here

# Partner integration settings
SHAMBA_API_URL=
# Optional: current Team 14 contract allows public reads. Set only if they enable X-API-Key.
SHAMBA_API_KEY=
# Change only when Team 14 confirms a different auth header or Bearer scheme.
SHAMBA_API_KEY_HEADER=X-API-Key
SHAMBA_API_KEY_PREFIX=
# Optional key from API_KEYS for the local Vite proxy; falls back to its first key.
SETTLEIN_WEB_API_KEY=
SHAMBA_LISTING_ID=1
SHAMBA_FARMER_ID=1
SHAMBA_HEADQUARTERS_ID=1
